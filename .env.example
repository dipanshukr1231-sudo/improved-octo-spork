# Copy this file to ".env" and edit it. NEVER share or upload your real .env file.
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
DATABASE_URL=sqlite+aiosqlite:///./examyatra.db
# Your own Telegram numeric ID(s), comma separated. Admins can still use the bot in maintenance mode.
ADMIN_IDS=
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=ExamYatra is being updated. Please try again soon.
SUPPORT_CONTACT=
QUESTION_EXPIRY_MINUTES=10
LOG_LEVEL=INFO
